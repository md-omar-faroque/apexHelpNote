var day   = parts[0];
var month = parts[1];
var year  = parts[2];

var isoDate = year + '-' + month + '-' + day;

apex.region("Region Static Id").widget().data("fullCalendar").gotoDate(isoDate); // Show date to calender

setTimeout(() => {
    highlightCalendarDate()
}, 100);

